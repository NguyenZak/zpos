NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for dev sandbox/mock APIs that need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: use this when sending to a topic inside a Telegram forum group.
TELEGRAM_MESSAGE_THREAD_ID=
# Optional: separate thread IDs for different log types (Telegram forums)
TELEGRAM_THREAD_ID_AUDIT=
TELEGRAM_THREAD_ID_TICKETS=
TELEGRAM_THREAD_ID_LOGBUGS=
# Optional: set false to disable server audit/security log notifications.
TELEGRAM_LOG_ENABLED=true
# Optional: info | warning | error | critical. Alerts are always sent.
TELEGRAM_LOG_MIN_SEVERITY=warning
